{
    "title": "messages",
    "type": "object",
    "description": "用户与系统之间的交互记录",
    "properties": {
        "id": {
            "type": "integer",
            "description": "内部主键，自增"
        },
        "project_public_id": {
            "type": "string",
            "maxLength": 36,
            "description": "所属项目的 public_id"
        },
        "role": {
            "type": "string",
            "maxLength": 16,
            "description": "user 或 assistant"
        },
        "content": {
            "type": "string",
            "description": "用户消息为原始描述，助手消息为结果摘要"
        },
        "version_seq": {
            "type": "integer",
            "description": "助手消息关联的版本序号，用户消息为空"
        }
    },
    "required": [
        "project_public_id",
        "role",
        "content"
    ]
}