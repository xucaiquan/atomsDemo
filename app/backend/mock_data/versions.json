        "prompt": "做一个待办清单，支持添加、勾选完成和按状态筛选",
        "html": "<!DOCTYPE html><html lang='zh-CN'><head><meta charset='UTF-8'><meta http-equiv='Content-Security-Policy' content='default-src &#39;none&#39;; style-src &#39;unsafe-inline&#39;; script-src &#39;unsafe-inline&#39;; img-src data: blob:'><title>今日待办清单</title><style>body{font-family:system-ui,'PingFang SC','Microsoft YaHei',sans-serif;background:#0f172a;color:#e2e8f0;max-width:560px;margin:0 auto;padding:28px}h1{font-size:22px;margin:0 0 4px}p.sub{color:#94a3b8;font-size:13px;margin:0 0 18px}.top{display:flex;gap:8px}input{flex:1;padding:10px 12px;border-radius:8px;border:1px solid #334155;background:#1e293b;color:#e2e8f0;font-size:14px}.add{background:#0ea5e9;border:none;color:#fff;border-radius:8px;padding:0 18px;font-weight:600;cursor:pointer}.filters{display:flex;gap:8px;margin:14px 0}.f{border:1px solid #334155;background:transparent;color:#94a3b8;border-radius:999px;padding:4px 14px;font-size:12px;cursor:pointer}.f.on{border-color:#38bdf8;color:#38bdf8;background:rgba(56,189,248,.12)}ul{list-style:none;padding:0}li{display:flex;align-items:center;gap:10px;background:#1e293b;border-radius:10px;padding:11px 14px;margin:8px 0}li.done .tx{text-decoration:line-through;color:#64748b}.cb{width:18px;height:18px;border-radius:5px;border:2px solid #475569;background:transparent;cursor:pointer}li.done .cb{background:#34d399;border-color:#34d399}.tx{flex:1;font-size:14px}.del{background:none;border:none;color:#64748b;cursor:pointer;font-size:15px}.del:hover{color:#f87171}#stat{margin-top:14px;font-size:12px;color:#94a3b8}#msg{color:#f87171;font-size:12px;min-height:16px}</style></head><body><h1>✅ 今日待办</h1><p class='sub'>添加任务，勾选完成，按状态筛选</p><div class='top'><input id='i' placeholder='想做什么？' maxlength='30'><button class='add' id='addBtn'>添加</button></div><p id='msg'></p><div class='filters'><button class='f on' id='f-all'>全部</button><button class='f' id='f-active'>进行中</button><button class='f' id='f-done'>已完成</button></div><ul id='u'></ul><p id='stat'></p><script>var todos=[{t:'晨会同步进度',d:true},{t:'完成 Demo 验收',d:false},{t:'整理本周周报',d:false}],filter='all';function add(){var v=document.getElementById('i').value.trim();if(!v){document.getElementById('msg').textContent='请输入待办内容';return}document.getElementById('msg').textContent='';todos.unshift({t:v,d:false});document.getElementById('i').value='';draw()}function setF(f){filter=f;['all','active','done'].forEach(function(k){document.getElementById('f-'+k).className='f'+(k===f?' on':'')});draw()}function draw(){var u=document.getElementById('u');u.innerHTML='';var left=0;todos.forEach(function(x,i){if(!x.d)left++;if(filter==='active'&&x.d)return;if(filter==='done'&&!x.d)return;var li=document.createElement('li');if(x.d)li.className='done';var cb=document.createElement('button');cb.className='cb';cb.onclick=function(){x.d=!x.d;draw()};var tx=document.createElement('span');tx.className='tx';tx.textContent=x.t;var del=document.createElement('button');del.className='del';del.textContent='✕';del.onclick=function(){todos.splice(i,1);draw()};li.appendChild(cb);li.appendChild(tx);li.appendChild(del);u.appendChild(li)});document.getElementById('stat').textContent='共 '+todos.length+' 项，剩余 '+left+' 项未完成';if(!u.children.length){var e=document.createElement('li');e.style.color='#64748b';e.style.justifyContent='center';e.textContent='这个筛选下暂无任务';u.appendChild(e)}}document.getElementById('addBtn').onclick=add;document.getElementById('i').onkeydown=function(e){if(e.key==='Enter')add()};['all','active','done'].forEach(function(k){document.getElementById('f-'+k).onclick=function(){setF(k)}});draw();</script></body></html>",
