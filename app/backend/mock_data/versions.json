        "prompt": "做一个番茄钟，可以设置专注时长并统计今日完成次数",
        "html": "<!DOCTYPE html><html lang='zh-CN'><head><meta charset='UTF-8'><meta http-equiv='Content-Security-Policy' content='default-src &#39;none&#39;; style-src &#39;unsafe-inline&#39;; script-src &#39;unsafe-inline&#39;; img-src data: blob:'><title>番茄专注钟</title><style>body{font-family:system-ui,'PingFang SC','Microsoft YaHei',sans-serif;background:#0f172a;color:#e2e8f0;display:flex;min-height:100vh;align-items:center;justify-content:center;margin:0}.box{text-align:center;background:#1e293b;border-radius:20px;padding:40px 56px;box-shadow:0 20px 60px rgba(0,0,0,.4)}h1{font-size:18px;margin:0 0 6px}.mode{font-size:13px;color:#38bdf8;margin-bottom:16px}.time{font-size:72px;font-weight:700;font-variant-numeric:tabular-nums}.btns{display:flex;gap:10px;justify-content:center;margin-top:20px}button{border:none;border-radius:10px;padding:10px 20px;font-size:14px;cursor:pointer;background:#334155;color:#e2e8f0}.primary{background:#ef4444;color:#fff;font-weight:600}.count{margin-top:18px;font-size:13px;color:#94a3b8}#msg{min-height:18px;font-size:13px;color:#fbbf24;margin-top:10px}</style></head><body><div class='box'><h1>🍅 番茄专注钟</h1><div class='mode' id='mode'>专注模式 · 25 分钟</div><div class='time' id='time'>25:00</div><div class='btns'><button class='primary' id='start'>开始</button><button id='reset'>重置</button><button id='sw'>切换休息</button></div><div class='count' id='count'>今日完成 2 个番茄</div><div id='msg'></div></div><script>var FOCUS=1500,BREAK=300,remain=FOCUS,isFocus=true,timer=null,done=2;function el(id){return document.getElementById(id)}function fmt(s){var m=Math.floor(s/60),ss=s%60;return (m<10?'0':'')+m+':'+(ss<10?'0':'')+ss}function draw(){el('time').textContent=fmt(remain);el('mode').textContent=isFocus?'专注模式 · 25 分钟':'休息模式 · 5 分钟';el('count').textContent='今日完成 '+done+' 个番茄';el('sw').textContent=isFocus?'切换休息':'切换专注'}function stop(){if(timer){clearInterval(timer);timer=null}el('start').textContent='开始'}el('start').onclick=function(){if(timer){stop();el('msg').textContent='已暂停'}else{timer=setInterval(tick,1000);el('start').textContent='暂停';el('msg').textContent=''}};function tick(){remain--;if(remain<=0){stop();if(isFocus){done++;isFocus=false;remain=BREAK;el('msg').textContent='专注完成！休息一下吧 🎉'}else{isFocus=true;remain=FOCUS;el('msg').textContent='休息结束，开始下一个番茄 💪'}}draw()}el('reset').onclick=function(){stop();remain=isFocus?FOCUS:BREAK;el('msg').textContent='已重置';draw()};el('sw').onclick=function(){stop();isFocus=!isFocus;remain=isFocus?FOCUS:BREAK;el('msg').textContent='';draw()};draw();</script></body></html>",
