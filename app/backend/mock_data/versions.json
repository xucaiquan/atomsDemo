        "prompt": "做一个记账小工具，能记收入和支出，显示总余额",
        "html": "<!DOCTYPE html><html lang='zh-CN'><head><meta charset='UTF-8'><meta http-equiv='Content-Security-Policy' content='default-src &#39;none&#39;; style-src &#39;unsafe-inline&#39;; script-src &#39;unsafe-inline&#39;; img-src data: blob:'><title>轻记账</title><style>body{font-family:system-ui,'PingFang SC','Microsoft YaHei',sans-serif;background:#0f172a;color:#e2e8f0;max-width:560px;margin:0 auto;padding:28px}h1{font-size:22px}p.sub{color:#94a3b8;font-size:13px}input,select,button{padding:9px 12px;border-radius:8px;border:1px solid #334155;background:#1e293b;color:#e2e8f0;font-size:14px}button{background:#0ea5e9;border:none;color:#fff;font-weight:600;cursor:pointer}ul{list-style:none;padding:0}li{background:#1e293b;border-radius:10px;padding:10px 14px;margin:8px 0;display:flex;justify-content:space-between;align-items:center;gap:10px}li.in .am{color:#34d399}li.out .am{color:#f87171}#bal{margin-top:16px;font-size:16px;color:#38bdf8;font-weight:700}#msg{color:#f87171;font-size:12px;min-height:16px}.del{background:none;border:none;color:#64748b;cursor:pointer}</style></head><body><h1>💰 轻记账</h1><p class='sub'>第一版：先把记账跑起来</p><input id='n' placeholder='项目，如：午餐' maxlength='20'><input id='a' type='number' placeholder='金额' min='0.01' step='0.01' style='width:110px'><select id='t'><option value='out'>支出</option><option value='in'>收入</option></select><button onclick='add()'>记一笔</button><p id='msg'></p><ul id='u'></ul><p id='bal'></p><script>var r=[{n:'工资',a:8600,t:'in'},{n:'房租',a:2300,t:'out'},{n:'超市采购',a:186.5,t:'out'}];function add(){var n=document.getElementById('n').value.trim(),a=parseFloat(document.getElementById('a').value);if(!n||!(a>0)){document.getElementById('msg').textContent='请填写项目名称并输入大于 0 的金额';return}document.getElementById('msg').textContent='';r.unshift({n:n,a:a,t:document.getElementById('t').value});document.getElementById('n').value='';document.getElementById('a').value='';draw()}function draw(){var u=document.getElementById('u'),s=0;u.innerHTML='';r.forEach(function(x,i){s+=x.t==='in'?x.a:-x.a;var li=document.createElement('li');li.className=x.t;var l=document.createElement('span');l.textContent=x.n+(x.t==='in'?'（收入）':'（支出）');var v=document.createElement('span');v.className='am';v.textContent=(x.t==='in'?'+':'-')+'¥'+x.a.toFixed(2);var d=document.createElement('button');d.className='del';d.textContent='✕';d.onclick=function(){r.splice(i,1);draw()};li.appendChild(l);li.appendChild(v);li.appendChild(d);u.appendChild(li)});document.getElementById('bal').textContent='当前结余：¥'+s.toFixed(2)}draw();</script></body></html>",
